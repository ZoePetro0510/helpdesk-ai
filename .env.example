# Copy to .env and fill in. .env is ignored by git.

# --- Database (docker-compose) ---
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
# Used when running the API outside Docker (the db container is published on port 5433)
DATABASE_URL=postgresql+psycopg://helpdesk:change-me@localhost:5433/helpdesk

# --- LLM ---
# ollama (free, local: install from ollama.com, then `ollama pull llama3.2`)
# anthropic (Claude: set ANTHROPIC_API_KEY)
# fake (no model; only for tests)
LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Routing thresholds (cosine similarity of the best knowledge-base match) ---
MIN_RETRIEVAL_SCORE=0.55
AUTO_REPLY_SCORE=0.68
